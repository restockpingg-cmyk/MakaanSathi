# ============================================================
# SUPABASE — Settings → API
# ============================================================

# Project URL (Settings → API → Project URL)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Anon/Public key (Settings → API → Project API Keys → anon public)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Service Role key — KEEP SECRET, server-side only
# (Settings → API → Project API Keys → service_role)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ============================================================
# DATABASE — Settings → Database → Connection String
# ============================================================

# Pooled connection (Session mode) — used by Prisma for queries
# (Settings → Database → Connection String → URI → Mode: Session)
# Append ?pgbouncer=true&connection_limit=1 for serverless
DATABASE_URL=postgresql://postgres.xxxxxxxxxxxx:PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres?pgbouncer=true&connection_limit=1

# Direct connection — used by Prisma for migrations only
# (Settings → Database → Connection String → URI → Mode: Direct)
DIRECT_URL=postgresql://postgres:PASSWORD@db.xxxxxxxxxxxx.supabase.co:5432/postgres

# ============================================================
# TWILIO — console.twilio.com
# ============================================================

# Account SID (Console Dashboard)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Auth Token (Console Dashboard)
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# WhatsApp sender number (Messaging → Try it out → Send a WhatsApp message)
# Format: whatsapp:+14155238886
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# ============================================================
# CRON SECURITY
# ============================================================

# Random secret to protect cron endpoints — generate with: openssl rand -hex 32
CRON_SECRET=your-random-secret-here
